DATABASE_URL=sqlite:///./verifact.db
# PostgreSQL / Supabase direct or session pooler (server-side only):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
MODEL_TYPE=baseline
MODEL_PATH=artifacts/baseline.joblib
METRICS_PATH=artifacts/metrics.json
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# Optional; sends article headline/first claim to Google only when enabled:
FACT_CHECK_API_KEY=
EVIDENCE_ENABLED=false
UNCERTAINTY_THRESHOLD=0.65
